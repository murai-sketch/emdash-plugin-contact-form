{
	"name": "emdash-plugin-contact-form",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.1",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0 <2.0.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.4",
		"@emdash-cms/plugin-test": "^0.2.10",
		"emdash": "1.3.1",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"description": "EmDash の問い合わせフォームプラグイン。受け口・防御・保存・通知・確認メール・保存期間の後始末を管理画面の設定だけで使える。"
}
